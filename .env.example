# 同一套凭据同时注入 RabbitMQ 与 backend；不要提交实际 .env。
RABBITMQ_USER=middleware
RABBITMQ_PASSWORD=replace-with-a-strong-password

# Redis 与 backend 统一注入，独立于 RabbitMQ 密码；不发布宿主机端口。
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_DB=0
REDIS_KEY_PREFIX=middleware-service
REDIS_MAX_CONNECTIONS=20

# 平台登录、心跳和会话清理（秒）；心跳间隔须小于会话有效期。
PLATFORM_SESSION_TTL_SECONDS=90
PLATFORM_SESSION_CLEANUP_INTERVAL_SECONDS=10
PLATFORM_HEARTBEAT_INTERVAL_SECONDS=30

# 用户登录缓存独立计时，成功登录写入或有效查询时按此 TTL 续期。
USER_CACHE_TTL_SECONDS=90

# 助理任务存储于 Redis，不新增 RabbitMQ 流；以下参数均须为正整数。
# 容量包含待领取和处理中任务；同平台重复 pull 当前任务可续租。
ASSISTANT_TASK_MAX_PER_USER=1000
ASSISTANT_TASK_LEASE_SECONDS=300
# 完成确认后，发布去重记录与 ack 回执的保留时间（秒）。
ASSISTANT_TASK_RECEIPT_TTL_SECONDS=86400
# 仅合并尚未领取的 user_message；间隔以相邻原始消息为准，单位秒。
ASSISTANT_USER_MESSAGE_MERGE_MAX_MESSAGES=20
ASSISTANT_USER_MESSAGE_MERGE_MAX_BYTES=65536
ASSISTANT_USER_MESSAGE_MERGE_INTERVAL_SECONDS=30
# 每条任务最多附件数及单个附件最大字节数，默认 20 MiB。
ASSISTANT_TASK_MAX_FILES=10
ASSISTANT_TASK_MAX_FILE_BYTES=20971520

# A2A 默认消费窗口（1～100）：子平台消费请求，顶层消费单聊反馈；各自独立，可用平台 YAML 的 a2a_max_inflight 覆盖。
PLATFORM_A2A_MAX_INFLIGHT_PER_PLATFORM=3
# 各子平台未完成请求和顶层未确认单聊反馈的各自容量上限，包含待领取及有效执行中的条目。
PLATFORM_A2A_MAX_TASKS_PER_PLATFORM=1000
# 请求及单聊反馈租约（秒），通过相应 pull 的 renew_tasks / renew_messages 显式续租。
PLATFORM_A2A_LEASE_SECONDS=300
# 领取回执幂等保留时间（秒），不能短于租约；每次新领取或续租使用新的 Idempotency-Key。
PLATFORM_A2A_PULL_RECEIPT_TTL_SECONDS=86400
# 子平台回复完成请求和顶层逐条确认反馈的回执保留时间（秒），用于各自的幂等重试。
PLATFORM_A2A_COMPLETION_RECEIPT_TTL_SECONDS=86400

# 五个业务流名称须互不相同；registry 代号须与 platform.yaml 对应。
RABBITMQ_VHOST=/
RABBITMQ_REGISTRY_PLATFORM_CODE=registry
RABBITMQ_REQUEST_STREAM=ingestion-requests
RABBITMQ_RESULT_STREAM=ingestion-results
RABBITMQ_DELETION_REQUEST_STREAM=deletion-requests
RABBITMQ_DELETION_RESULT_STREAM=deletion-results
RABBITMQ_FILE_PERMISSION_STREAM=file-permission-adjustments

# 入库请求：每个平台一批预取的消息数与原始负载字节数上限。
INGESTION_CACHE_MAX_MESSAGES=100
INGESTION_CACHE_MAX_BYTES=4194304

# 入库结果：每个子平台一批预取的缓存上限。
REVIEW_CACHE_MAX_MESSAGES=100
REVIEW_CACHE_MAX_BYTES=4194304

# 删除请求：与入库请求的缓存独立。
DELETION_CACHE_MAX_MESSAGES=100
DELETION_CACHE_MAX_BYTES=4194304

# 删除结果：与入库结果的缓存独立。
DELETION_REVIEW_CACHE_MAX_MESSAGES=100
DELETION_REVIEW_CACHE_MAX_BYTES=4194304

# 文件权限调整：每个子平台的独立预取上限。
FILE_PERMISSION_CACHE_MAX_MESSAGES=100
FILE_PERMISSION_CACHE_MAX_BYTES=4194304
