# 复制为 platform.yaml；替换所有示例密钥，不要提交实际配置。
# a2a_max_inflight 为本平台消费窗口，省略或 null 时使用环境默认值；仅接受 1～100 的整数。
# knowledge-accumulation 用于单聊反馈窗口，子管理平台用于请求窗口，两者独立。
# A2A 子平台须同时设置 supports_a2a=true 和 is_sub_management_platform=true。
# 子管理平台必须填写非空 a2aresponsibility，例如“负责解答合同相关问题。”。
platforms:
  - code: registry
    name: 注册中心
    description: |
      ## 注册中心
      - 消费入库与删除申请并发布审核结果。
      - 发布平台文件权限调整。
      - 维护用户资料与平台管理员。
    secret: "change-this-registry-key"
    supports_a2a: false
    is_sub_management_platform: false
    a2aresponsibility: ""
    is_management_entry: false
    a2a_max_inflight: null

  - code: knowledge-accumulation
    name: 知识沉淀平台
    description: 同步用户总表、用户成功登录令牌和平台管理员总表。
    secret: "change-this-knowledge-accumulation-key"
    supports_a2a: false
    is_sub_management_platform: false
    a2aresponsibility: ""
    is_management_entry: false
    a2a_max_inflight: null

  - code: platform-a
    name: 子平台甲
    description: 提交入库与删除申请，消费审核结果和文件权限调整。
    secret: "change-this-platform-a-key"
    supports_a2a: false
    is_sub_management_platform: false
    a2aresponsibility: ""
    is_management_entry: false
    a2a_max_inflight: null
