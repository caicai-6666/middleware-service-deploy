# 复制为 platform.yaml；替换所有示例密钥，不要提交实际配置。
platforms:
  - code: registry
    name: 注册中心
    description: |
      ## 注册中心
      - 消费入库与删除申请并发布审核结果。
      - 发布平台文件权限调整。
      - 维护用户资料与平台管理员。
    secret: "change-this-registry-key"
    # false 时不出现在 platform/list 中；不影响登录和业务权限。
    show_in_list: true

  - code: knowledge-accumulation
    name: 知识沉淀平台
    description: 同步用户总表、用户成功登录令牌和平台管理员总表。
    secret: "change-this-knowledge-accumulation-key"
    show_in_list: false

  - code: platform-a
    name: 子平台甲
    description: 提交入库与删除申请，消费审核结果和文件权限调整。
    secret: "change-this-platform-a-key"
    show_in_list: true
